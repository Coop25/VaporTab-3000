{
  "manifest_version": 3,
  "name": "VaporTab-3000",
  "description": "A responsive and low-noise new tab page that shows your real bookmarks.",
  "version": "0.2.1",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "bookmarks",
    "favicon",
    "tabs"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "vaportab-3000@local",
      "data_collection_permissions": {
        "required": [
          "bookmarksInfo"
        ]
      }
    }
  },
  "chrome_url_overrides": {
    "newtab": "new-tab.html"
  }
}
